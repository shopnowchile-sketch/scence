{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/campaign-deliverables/[id]/sync-metrics/route.ts": {
      "memory": 1769,
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/brand-document-reminders", "schedule": "0 12 * * *" },
    { "path": "/api/cron/expire-attendance-confirmations", "schedule": "15 12 * * *" },
    { "path": "/api/cron/close-expired-campaign-applications", "schedule": "5 12 * * *" }
  ]
}
