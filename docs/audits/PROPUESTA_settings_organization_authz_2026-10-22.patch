+/**
+ * Quién puede tocar la organización: el equipo SCENCE (admin de plataforma) o un usuario con acceso
+ * de marca verificado y el permiso pedido, SOLO sobre la organización de su propia marca. Antes, un
+ * usuario sin acceso de marca resuelto (p. ej. miembro de una organización con varias marcas y sin
+ * brand_id) caía a getOrgId y podía leer o editar la organización sin ser admin.
+ */
+async function resolveOrgAccess(userId: string, admin: ReturnType<typeof createAdminClient>, permission: 'brand.read' | 'brand.manage') {
+  if (await isPlatformAdmin(userId, admin)) return { orgId: await getOrgId(userId, undefined, admin) }
+  const brandAccess = await resolveBrandAccess(userId)
+  if (!brandAccess || !hasBrandPermission(brandAccess, permission)) return { forbidden: true as const }
+  return { orgId: brandAccess.organizationId }
+}
