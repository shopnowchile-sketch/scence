+const BRAND_TONES = [
+  { bg: 'bg-violet-100', text: 'text-violet-700', name: 'text-violet-700', ring: 'border-violet-200' },
+  { bg: 'bg-blue-100', text: 'text-blue-700', name: 'text-blue-700', ring: 'border-blue-200' },
+  { bg: 'bg-emerald-100', text: 'text-emerald-700', name: 'text-emerald-700', ring: 'border-emerald-200' },
+  { bg: 'bg-amber-100', text: 'text-amber-700', name: 'text-amber-700', ring: 'border-amber-200' },
+  { bg: 'bg-rose-100', text: 'text-rose-700', name: 'text-rose-700', ring: 'border-rose-200' },
+  { bg: 'bg-cyan-100', text: 'text-cyan-700', name: 'text-cyan-700', ring: 'border-cyan-200' },
+] as const
+
+function brandTone(value: string) {
+  const hash = Array.from(value).reduce((total, char) => ((total * 31) + char.charCodeAt(0)) >>> 0, 0)
+  return BRAND_TONES[hash % BRAND_TONES.length]
+}
+
+function instagramHandle(value?: string | null) {
+  return value?.trim().replace(/^https?:\/\/(www\.)?instagram\.com\//i, '').replace(/^@/, '').replace(/\/$/, '') ?? ''
+}
+
+function BrandMark({ brand, size = 'md' }: { brand: Brand; size?: 'sm' | 'md' | 'lg' }) {
+  const [imageFailed, setImageFailed] = useState(false)
+  const tone = brandTone(brand.id || brand.name)
+  const sizes = size === 'sm' ? 'h-8 w-8 rounded-lg text-[10px]' : size === 'lg' ? 'h-14 w-14 rounded-xl text-sm' : 'h-12 w-12 rounded-xl text-xs'
+
+  if (brand.logo_url && !imageFailed) {
+    return (
+      <img
+        src={brand.logo_url}
+        alt=""
+        onError={() => setImageFailed(true)}
+        className={cn(sizes, 'object-contain border bg-white p-1 flex-shrink-0', tone.ring)}
+      />
+    )
+  }
+
+  return (
+    <div className={cn(sizes, 'flex items-center justify-center border font-bold leading-none flex-shrink-0', tone.bg, tone.text, tone.ring)}>
+      {initials(brand.name)}
+    </div>
+  )
+}
